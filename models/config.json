{
  "default_model": "mobilenet-ssd",
  "models": {
    "mobilenet-ssd": {
      "file": "mobilenet-ssd.onnx",
      "input_size": [300, 300],
      "preprocessing": {
        "mean": [127.5, 127.5, 127.5],
        "std": [127.5, 127.5, 127.5],
        "format": "RGB"
      },
      "postprocessing": {
        "confidence_threshold": 0.5,
        "nms_threshold": 0.4
      }
    },
    "yolov5n": {
      "file": "yolov5n.onnx", 
      "input_size": [640, 640],
      "preprocessing": {
        "mean": [0, 0, 0],
        "std": [255, 255, 255],
        "format": "RGB"
      },
      "postprocessing": {
        "confidence_threshold": 0.25,
        "nms_threshold": 0.45
      }
    }
  }
}
